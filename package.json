{
  "name": "news-bot",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm test && npm audit"
  },
  "keywords": [
    "telegram-bot",
    "gemini-api",
    "rss",
    "nodejs",
    "news-aggregator"
  ],
  "author": "Mykhailo Loniak",
  "license": "MIT",
  "description": "A privacy-conscious Telegram news bot powered by RSS, Gemini, and SQLite.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MykhailoLoniak/news-bot.git"
  },
  "bugs": {
    "url": "https://github.com/MykhailoLoniak/news-bot/issues"
  },
  "homepage": "https://github.com/MykhailoLoniak/news-bot#readme",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "rss-parser": "^3.13.0",
    "telegraf": "^4.16.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  }
}
